t.IsSuffix`, and `List.IsInfix`.\n       22→-/\n       23→\n       24→set_option linter.listVariables true -- Enforce naming conventions for `List`/`Array`/`Vector` variables.\n       25→set_option linter.indexVariables true -- Enforce naming conventions for index variables.\n       26→\n       27→namespace List\n       28→\n       29→open Nat\n       30→\n       31→/-! ### isPrefixOf -/\n       32→section isPrefixOf\n       33→variable [BEq α]\n       34→\n       35→@[simp, grind =] theorem isPrefixOf_cons_cons_self [LawfulBEq α] {a : α} :\n       36→    isPrefixOf (a::as) (a::bs) = isPrefixOf as bs := by simp [isPrefixOf_cons_cons]\n       37→\n       38→@[deprecated isPrefixOf_cons_cons_self (since := \"2026-02-26\")]\n       39→theorem isPrefixOf_cons₂_self [LawfulBEq α] {a : α} :\n       40→    isPrefixOf (a::as) (a::bs) = isPrefixOf as bs := isPrefixOf_cons_cons_self\n       41→\n       42→@[simp] theorem isPrefixOf_length_pos_nil {l : List α} (h : 0 < l.length) : isPrefixOf l [] = false := by\n       43→  cases l <;> simp_all [isPrefixOf]\n       44→\n       45→@[simp, grind =] theorem isPrefixOf_replicate {a : α} :\n       46→    isPrefixOf l (replicate n a) = ((l.length ≤ n) && l.all (· == a)) := by\n       47→  induction l generalizing n with\n       48→  | nil => simp\n       49→  | cons _ _ ih =>\n       50→    cases n\n       51→    · simp\n       52→    · simp [replicate_succ, isPrefixOf_cons_cons, ih, Nat.succ_le_succ_iff, Bool.and_left_comm]\n       53→\n       54→end isPrefixOf\n       55→\n       56→/-! ### isSuffixOf -/\n       57→section isSuffixOf\n       58→variable [BEq α]\n       59→\n       60→@[simp, grind =] theorem isSuffixOf_cons_nil : isSuffixOf (a::as) ([] : List α) = false := by\n       61→  simp [isSuffixOf]\n       62→\n       63→@[simp, grind =] theorem isSuffixOf_replicate {a : α} :\n       64→    isSuffixOf l (replicate n a) = (decide (l.length ≤ n) && l.all (· == a)) := by\n       65→  simp [isSuffixOf, all_eq]\n       66→\n       67→end isSuffixOf\n       68→\n       69→/-! ### Subset -/\n       70→\n       71→/-! ### List subset -/\n       72→\n       73→-- For now we don't annotate lemmas about `Subset` for `grind`, but instead just unfold the definition.\n       74→@[grind =] theorem subset_def {l₁ l₂ : List α} : l₁ ⊆ l₂ ↔ ∀ {a : α}, a ∈ l₁ → a ∈ l₂ := .rfl\n       75→\n       76→@[simp] theorem nil_subset (l : List α) : [] ⊆ l := nofun\n       77→\n       78→@[simp] theorem Subset.refl (l : List α) : l ⊆ l := fun _ i => i\n       79→\n       80→theorem Subset.trans {l₁ l₂ l₃ : List α} (h₁ : l₁ ⊆ l₂) (h₂ : l₂ ⊆ l₃) : l₁ ⊆ l₃ :=\n       81→  fun _ i => h₂ (h₁ i)\n       82→\n       83→instance : Trans (fun l₁ l₂ => Subset l₂ l₁) (Membership.mem : List α → α → Prop) Membership.mem :=\n       84→  ⟨fun h₁ h₂ => h₁ h₂⟩\n       85→\n       86→instance : Trans (Subset : List α → List α → Prop) Subset Subset :=\n       87→  ⟨Subset.trans⟩\n       88→\n       89→theorem subset_cons_self (a : α) (l : List α) : l ⊆ a :: l := fun _ => Mem.tail _\n       90→\n       91→theorem subset_of_cons_subset {a : α} {l₁ l₂ : List α} : a :: l₁ ⊆ l₂ → l₁ ⊆ l₂ :=\n       92→  fun s _ i => s (mem_cons_of_mem _ i)\n       93→\n       94→@[simp] theorem subset_cons_of_subset (a : α) {l₁ l₂ : List α} : l₁ ⊆ l₂ → l₁ ⊆ a :: l₂ :=\n       95→  fun s _ i => .tail _ (s i)\n       96→\n       97→theorem cons_subset_cons {l₁ l₂ : List α} (a : α) (s : l₁ ⊆ l₂) : a :: l₁ ⊆ a :: l₂ :=\n       98→  fun _ => by simp only [mem_cons]; exact Or.imp_right (@s _)\n       99→\n      100→@[simp] theorem cons_subset : a :: l ⊆ m ↔ a ∈ m ∧ l ⊆ m := by", "numLines": 100, "startLine": 1, "requestedOffset": null, "requestedLimit": 100, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 1.8633750005392358, "display": {"success": true, "verb": "Read", "message": "100 lines from Sublist.lean", "warnings": [], "suffix": "(truncated)"}}}
