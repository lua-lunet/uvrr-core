\n    combined list is at most the sum of the original list. -/\nlemma sum_two_disjoint_sublists_le {A : Type} [DecidableEq A] (f : A → Nat)\n    {l₁ l₂ nodes : List A} (hnd : nodes.Nodup)\n    (h₁ : l₁ <+ nodes) (h₂ : l₂ <+ nodes)\n    (hdisj : ∀ a, a ∈ l₁ → a ∉ l₂) :\n    (l₁.map f).sum + (l₂.map f).sum ≤ (nodes.map f).sum := by\n  induction nodes generalizing l₁ l₂ with\n  | nil =>\n    have hl₁ : l₁ = [] := by\n      cases l₁ <;> cases h₁ <;> rfl\n    have hl₂ : l₂ = [] := by\n      cases l₂ <;> cases h₂ <;> rfl\n    simp [hl₁, hl₂]\n  | cons a nodes IH =>\n    by_cases ha₁ : a ∈ l₁\n    · -- a ∈ l₁: strip a from l₁\n      obtain ⟨l₁', hl₁_eq, h₁'⟩ : ∃ l₁', l₁ = a :: l₁' ∧ l₁' <+ nodes := by\n        cases l₁ with\n        | nil => simp at ha₁\n        | cons b l₁' =>\n          cases h₁ with\n          | slnil => simp\n          | cons _ h₁'_ =>\n            -- l₁ <+ a :: nodes via `cons a h₁'_`\n            -- So l₁ <+ nodes and we can use IH\n            simp at ha₁\n            cases ha₁ with\n            | head => exact ⟨l₁', rfl, h₁'_⟩\n            | tail _ ha₁'_ =>\n              -- a is in the tail, so l₁ = b :: l₁'' where a ∈ l₁''\n              -- But we know l₁ <+ a :: nodes, and b :: l₁'' <+ a :: nodes\n              -- This is only possible if b = a (via cons_cons) or b :: l₁'' <+ nodes (via cons)\n              -- Actually, we need to look at the structure more carefully\n              sorry\n          | cons_cons _ h₁'_ =>\n            simp at ha₁\n            cases ha₁ with\n            | head => exact ⟨l₁', rfl, h₁'_⟩\n            | tail _ ha₁'_ => sorry\n      sorry\n    · -- a ∉ l₁\n      by_cases ha₂ : a ∈ l₂\n      · -- a ∈ l₂: symmetric to above\n        sorry\n      · -- a ∉ l₁ and a ∉ l₂\n        have h₁' : l₁ <+ nodes := by\n          cases h₁ with\n          | slnil => exact .slnil _\n          | cons _ h₁' => exact h₁'\n          | cons_cons a' h₁' =>\n            -- l₁ <+ a :: nodes via cons_cons a'\n            -- This means l₁ = a' 