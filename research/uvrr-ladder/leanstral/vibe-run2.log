h\n      185→    | .slnil => apply nil_sublist\n      186→    | .cons a' h₁' => cases e; apply (IH h₁').cons\n      187→    | .cons_cons a' h₁' => cases e; apply (IH h₁').cons_cons\n      188→\n      189→instance : Trans (@Sublist α) Sublist Sublist := ⟨Sublist.trans⟩\n      190→\n      191→attribute [simp, grind ←] Sublist.cons\n      192→\n      193→theorem sublist_cons_self (a : α) (l : List α) : l <+ a :: l := (Sublist.refl l).cons _\n      194→\n      195→theorem sublist_of_cons_sublist : a :: l₁ <+ l₂ → l₁ <+ l₂ :=\n      196→  (sublist_cons_self a l₁).trans\n      197→\n      198→@[simp, grind =]\n      199→theorem cons_sublist_cons : a :: l₁ <+ a :: l₂ ↔ l₁ <+ l₂ :=\n      200→  ⟨fun | .cons _ s => sublist_of_cons_sublist s | .cons_cons _ s => s, .cons_cons _⟩\n      201→\n      202→theorem sublist_or_mem_of_sublist (h : l <+ l₁ ++ a :: l₂) : l <+ l₁ ++ l₂ ∨ a ∈ l := by\n      203→  induction l₁ generalizing l with\n      204→  | nil => match h with\n      205→    | .cons _ h => exact .inl h\n      206→    | .cons_cons _ h => exact .inr (.head ..)\n      207→  | cons b l₁ IH =>\n      208→    match h with\n      209→    | .cons _ h => exact (IH h).imp_left (Sublist.cons _)\n      210→    | .cons_cons _ h => exact (IH h).imp (Sublist.cons_cons _) (.tail _)\n      211→\n      212→@[grind →] theorem Sublist.subset : l₁ <+ l₂ → l₁ ⊆ l₂\n      213→  | .slnil, _, h => h\n      214→  | .cons _ s, _, h => .tail _ (s.subset h)\n      215→  | .cons_cons .., _, .head .. => .head ..\n      216→  | .cons_cons _ s, _, .tail _ h => .tail _ (s.subset h)\n      217→", "numLines": 50, "startLine": 168, "requestedOffset": 168, "requestedLimit": 50, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 1.7442079988541082, "display": {"success": true, "verb": "Read", "message": "50 lines from Sublist.lean", "warnings": [], "suffix": "(truncated)"}}}
