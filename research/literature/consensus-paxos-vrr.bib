@article{ailidaniailijiang2019,
  title = {{{WPaxos}}: {{Wide Area Network Flexible Consensus}}},
  author = {{Ailidani Ailijiang} and {Aleksey Charapko} and {Murat Demirbas} and {Tevfik Kosar}},
  year = 2019,
  url = {https://arxiv.org/abs/1703.08905},
  abstract = {WPaxos is a multileader Paxos protocol that provides low-latency and high-throughput consensus across wide-area network deployments. It partitions the object space among leaders and adapts to changing access locality through object stealing. Concurrent leaders take ownership of objects with phase 1 and commit updates locally with phase 2 using flexible quorums and nearby acceptors. The implementation is evaluated across five AWS regions.}
}

